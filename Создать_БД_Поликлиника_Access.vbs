' 4. Создание запросов
db.CreateQueryDef "Запрос_01_СвободныеТалоныПоСпециальности", _
    "PARAMETERS [Введите дату приёма] DateTime, [Введите специальность врача] Text ( 100 ); " & _
    "SELECT [Врачи].[КодВрача], [Врачи].[ФИО_Врача] AS [Врач], [Специальности].[НаименованиеСпециальности] AS [Специальность], " & _
    "[Врачи].[Кабинет], [РасписаниеПриема].[ДатаСмены] AS [Дата приёма], [РасписаниеПриема].[ВремяНачала] AS [Начало приёма], " & _
    "[РасписаниеПриема].[ВремяОкончания] AS [Конец приёма] " & _
    "FROM ([Специальности] INNER JOIN [Врачи] ON [Специальности].[КодСпециальности] = [Врачи].[КодСпециальности]) " & _
    "INNER JOIN [РасписаниеПриема] ON [Врачи].[КодВрача] = [РасписаниеПриема].[КодВрача] " & _
    "WHERE ((([Специальности].[НаименованиеСпециальности])=[Введите специальность врача]) AND (([РасписаниеПриема].[ДатаСмены])=[Введите дату приёма]));"

db.CreateQueryDef "Запрос_02_ИсторияПосещенийПациента", _
    "PARAMETERS [Введите фамилию пациента] Text ( 100 ); " & _
    "SELECT [Пациенты].[ФИО_Пациента] AS [Пациент], [Пациенты].[ДатаРождения] AS [Дата рождения], [Пациенты].[ПолисОМС] AS [Полис ОМС], " & _
    "[ЗаписиНаПрием].[НомерТалона] AS [Номер талона], [ЗаписиНаПрием].[ДатаПриема] AS [Дата визита], [ЗаписиНаПрием].[ВремяПриема] AS [Время визита], " & _
    "[Врачи].[ФИО_Врача] AS [Лечащий врач], [Специальности].[НаименованиеСпециальности] AS [Специальность], " & _
    "[Диагнозы].[КодМКБ] AS [Код МКБ-10], [Диагнозы].[НаименованиеДиагноза] AS [Поставленный диагноз], " & _
    "[МедицинскиеУслуги].[НаименованиеУслуги] AS [Оказанная услуга], [МедицинскиеУслуги].[Стоимость] AS [Цена услуги], " & _
    "[Назначения].[Медикаменты] AS [Назначенные препараты] " & _
    "FROM [Специальности] INNER JOIN ([Врачи] INNER JOIN ([Пациенты] INNER JOIN ([Диагнозы] " & _
    "INNER JOIN ([МедицинскиеУслуги] INNER JOIN ([ЗаписиНаПрием] " & _
    "INNER JOIN [Назначения] ON [ЗаписиНаПрием].[КодЗаписи] = [Назначения].[КодЗаписи]) " & _
    "ON [МедицинскиеУслуги].[КодУслуги] = [Назначения].[КодУслуги]) ON [Диагнозы].[КодДиагноза] = [Назначения].[КодДиагноза]) " & _
    "ON [Пациенты].[КодПациента] = [ЗаписиНаПрием].[КодПациента]) ON [Врачи].[КодВрача] = [ЗаписиНаПрием].[КодВрача]) " & _
    "ON [Специальности].[КодСпециальности] = [Врачи].[КодСпециальности] " & _
    "WHERE ((([Пациенты].[ФИО_Пациента]) Like '*' & [Введите фамилию пациента] & '*')) " & _
    "ORDER BY [ЗаписиНаПрием].[ДатаПриема] DESC, [ЗаписиНаПрием].[ВремяПриема] DESC;"

db.CreateQueryDef "Запрос_03_РасчетСтоимостиУслугСоСкидкой", _
    "SELECT [ЗаписиНаПрием].[НомерТалона] AS [Талон], [ЗаписиНаПрием].[ДатаПриема] AS [Дата], " & _
    "[Пациенты].[ФИО_Пациента] AS [Пациент], [Врачи].[ФИО_Врача] AS [Врач], " & _
    "[Специальности].[НаименованиеСпециальности] AS [Специальность], [МедицинскиеУслуги].[НаименованиеУслуги] AS [Услуга], " & _
    "[МедицинскиеУслуги].[Стоимость] AS [Тариф], [Назначения].[Количество], " & _
    "([МедицинскиеУслуги].[Стоимость]*[Назначения].[Количество]) AS [СуммаБезСкидки], " & _
    "IIf(([МедицинскиеУслуги].[Стоимость]*[Назначения].[Количество])>1000,([МедицинскиеУслуги].[Стоимость]*[Назначения].[Количество])*0.9,([МедицинскиеУслуги].[Стоимость]*[Назначения].[Количество])) AS [ИтоговаяСтоимостьСоСкидкой] " & _
    "FROM [Специальности] INNER JOIN ([Врачи] INNER JOIN ([Пациенты] INNER JOIN ([МедицинскиеУслуги] " & _
    "INNER JOIN ([ЗаписиНаПрием] INNER JOIN [Назначения] ON [ЗаписиНаПрием].[КодЗаписи] = [Назначения].[КодЗаписи]) " & _
    "ON [МедицинскиеУслуги].[КодУслуги] = [Назначения].[КодУслуги]) ON [Пациенты].[КодПациента] = [ЗаписиНаПрием].[КодПациента]) " & _
    "ON [Врачи].[КодВрача] = [ЗаписиНаПрием].[КодВрача]) ON [Специальности].[КодСпециальности] = [Врачи].[КодСпециальности];"

db.CreateQueryDef "Запрос_04_ИтоговаяЗагрузкаВрачей", _
    "SELECT [Специальности].[НаименованиеСпециальности] AS [Специальность], [Врачи].[ФИО_Врача] AS [Врач], [Врачи].[Кабинет], " & _
    "Count([ЗаписиНаПрием].[КодЗаписи]) AS [ПринятоПациентов], " & _
    "Sum([МедицинскиеУслуги].[Стоимость]) AS [СуммаОказанныхУслуг], " & _
    "Avg([МедицинскиеУслуги].[Стоимость]) AS [СредняяСтоимостьПриема] " & _
    "FROM [Специальности] INNER JOIN ([Врачи] INNER JOIN ([МедицинскиеУслуги] " & _
    "INNER JOIN ([ЗаписиНаПрием] INNER JOIN [Назначения] ON [ЗаписиНаПрием].[КодЗаписи] = [Назначения].[КодЗаписи]) " & _
    "ON [МедицинскиеУслуги].[КодУслуги] = [Назначения].[КодУслуги]) ON [Врачи].[КодВрача] = [ЗаписиНаПрием].[КодВрача]) " & _
    "ON [Специальности].[КодСпециальности] = [Врачи].[КодСпециальности] " & _
    "GROUP BY [Специальности].[НаименованиеСпециальности], [Врачи].[ФИО_Врача], [Врачи].[Кабинет] " & _
    "ORDER BY Count([ЗаписиНаПрием].[КодЗаписи]) DESC;"

db.CreateQueryDef "Запрос_05_СписокРаботающихВрачей", _
    "SELECT [Врачи].[КодВрача], [Врачи].[ФИО_Врача] AS [ФИО Врача], [Специальности].[НаименованиеСпециальности] AS [Специальность], " & _
    "[Врачи].[Кабинет], [Врачи].[Телефон], [Врачи].[Категория] " & _
    "FROM [Специальности] INNER JOIN [Врачи] ON [Специальности].[КодСпециальности] = [Врачи].[КодСпециальности] " & _
    "WHERE ((([Врачи].[Статус])='Работает')) " & _
    "ORDER BY [Специальности].[НаименованиеСпециальности], [Врачи].[ФИО_Врача];"

db.CreateQueryDef "Запрос_06_ДобавлениеНовогоПациента", _
    "PARAMETERS [ФИО нового пациента] Text ( 100 ), [Дата рождения] DateTime, [Пол М или Ж] Text ( 1 ), " & _
    "[Адрес проживания] Text ( 200 ), [Номер телефона] Text ( 20 ), [Номер полиса ОМС] Text ( 16 ); " & _
    "INSERT INTO [Пациенты] ( [ФИО_Пациента], [ДатаРождения], [Пол], [Адрес], [Телефон], [ПолисОМС] ) " & _
    "VALUES ([ФИО нового пациента], [Дата рождения], [Пол М или Ж], [Адрес проживания], [Номер телефона], [Номер полиса ОМС]);"

db.CreateQueryDef "Запрос_07_ПакетнаяИндексацияЦен", _
    "PARAMETERS [Введите процент повышения] IEEEDouble, [Введите код специальности] Long; " & _
    "UPDATE [МедицинскиеУслуги] " & _
    "SET [МедицинскиеУслуги].[Стоимость] = Round([Стоимость]*(1+[Введите процент повышения]/100),2) " & _
    "WHERE ((([МедицинскиеУслуги].[КодСпециальности])=[Введите код специальности]));"

db.CreateQueryDef "Запрос_08_УдалениеОтмененныхЗаписей", _
    "PARAMETERS [Удалить отмененные талоны до даты] DateTime; " & _
    "DELETE [ЗаписиНаПрием].*, [ЗаписиНаПрием].[ДатаПриема], [ЗаписиНаПрием].[Статус] " & _
    "FROM [ЗаписиНаПрием] " & _
    "WHERE ((([ЗаписиНаПрием].[ДатаПриема])<[Удалить отмененные талоны до даты]) AND (([ЗаписиНаПрием].[Статус])='Отменен'));"

